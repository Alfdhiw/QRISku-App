# Local IDE, Gradle caches, and generated build output
.gradle/
.idea/
local.properties
**/build/
*.iml
.verification/

# Environment files may contain credentials; only sanitized examples are public
.env
.env.*
*.env
.envrc
.envrc.*
!.env.example
!.env.sample
!.env.template

# Android signing configuration (never put passwords in tracked gradle.properties)
keystore*.properties*
key.properties*
signing*.properties*
*.local.properties

# Private keys, signing keystores, and their backup copies
*.jks
*.jks.*
*.keystore
*.keystore.*
*.jceks
*.jceks.*
*.bks
*.bks.*
*.p12
*.p12.*
*.pfx
*.pfx.*
*.pkcs12
*.pkcs12.*
*.pk8
*.pk8.*
*.pkcs8
*.pkcs8.*
*.pem
*.pem.*
*.key
*.key.*
*.kdbx
keystore/
keystores/
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# Local authentication files and secret directories (including nested copies)
.aws/
.ssh/
**/.config/gcloud/
secrets/
.secrets/
credentials/
.git-credentials
.netrc
_netrc
credentials*.json*
client_secret*.json*
*service-account*.json*
*service_account*.json*
*serviceAccount*.json*
*firebase-adminsdk*.json*
application_default_credentials.json*

# Local application artifacts and diagnostics can contain sensitive data
*.apk
*.aab
*.apks
*.hprof
*.log
